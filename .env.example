# Environment Variables for RAG Document Chatbot
# Copy this file to .env and fill in your actual values.
# All variables below are REQUIRED unless marked optional.

# --- Groq API (Chat Completions) ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Google Gemini API (Embeddings Only) ---
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Qdrant Cloud (Vector Store) ---
# Sign up for a free cluster at: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# (Optional) Name of the Qdrant collection to use. Default: document-chatbot
QDRANT_COLLECTION_NAME=document-chatbot

# --- Server ---
# (Optional) Port the Express server listens on. Default: 3000
PORT=3000

# --- Upload Limits ---
# (Optional) Max file size in bytes. Default: 10485760 (10 MB)
MAX_FILE_SIZE=10485760
